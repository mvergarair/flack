{
  "name": "flack-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5317 --strictPort",
    "build": "tsc -p tsconfig.json && vite build && node ../scripts/build-api-docs.mjs web/dist",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "build:emu": "vite build --mode emulator --outDir dist-emu && node ../scripts/build-api-docs.mjs web/dist-emu",
    "preview:emu": "vite preview --outDir dist-emu --port 5318 --strictPort --host 127.0.0.1"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "firebase": "^12.19.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@scalar/api-reference": "^1.76.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "yaml": "^2.9.1"
  }
}
