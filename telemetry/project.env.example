# Maintainers only: the project that collects anonymous statistics from Flack installs.
# Copy to telemetry/project.env (gitignored). The Flack scripts pin themselves to this project
# when run with FLACK_PROJECT_ENV=telemetry/project.env (see telemetry/deploy.sh).
FLACK_PROJECT="flack-telemetry-mv"
FLACK_REGION="us-central1"
