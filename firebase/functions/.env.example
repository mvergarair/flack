# Written by `npm run setup` as firebase/functions/.env.<project-id>.
# The first account with this email to sign in becomes the admin.
FIRST_ADMIN_EMAIL=you@example.com
APP_URL=https://your-project-id.web.app
FLACK_REGION=us-central1
# Anonymous usage statistics (TELEMETRY.md): on or off.
FLACK_TELEMETRY=on
