rules_version = '2';

// Flack Firestore rules. These are the only backend protection for client traffic:
// every rule is covered by firebase/rules-tests.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      // One billed read per request; cached across calls within the same request.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Active = signed in, claim says active, AND the user doc says active. The doc check
    // locks a deactivated user out immediately even while their ID token is still valid.
    function isActive() {
      return signedIn()
        && request.auth.token.active == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status == 'active';
    }
    function isAdmin() {
      return isActive() && request.auth.token.role == 'admin' && me().role == 'admin';
    }
    function channel(channelId) {
      return get(/databases/$(database)/documents/channels/$(channelId)).data;
    }
    function isMemberOf(channelId) {
      return request.auth.uid in channel(channelId).memberIds;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function validName(n) {
      return n is string && n.matches('^[a-z0-9][a-z0-9_-]{0,79}$');
    }
    function uniqueList(l) {
      return l is list && l.toSet().size() == l.size();
    }
    // Ids end up inside Storage paths and regexes below, so keep them to a safe alphabet.
    function safeId(id) {
      return id.matches('^[A-Za-z0-9_-]{1,100}$');
    }
    // Secret per-channel key for typing indicators in RTDB (which can't check membership):
    // only people who can read the channel doc learn it.
    function validTypingKey(k) {
      return k is string && k.matches('^t_[A-Za-z0-9]{20,40}$');
    }
    // Attachments must point into the message's own Storage folder (the cleanup functions act
    // on these paths with admin rights, and readers fetch them).
    function validAttachment(a, channelId, messageId) {
      return a is map
        && a.keys().hasOnly(['name', 'size', 'contentType', 'storagePath', 'thumbPath', 'width', 'height'])
        && a.storagePath is string
        && a.storagePath.matches('^channels/' + channelId + '/' + messageId + '/[^/]{1,200}$')
        && (!('thumbPath' in a) || a.thumbPath == null
          || (a.thumbPath is string && a.thumbPath.matches('^channels/' + channelId + '/' + messageId + '/[^/]{1,220}$')));
    }
    function validAttachments(l, channelId, messageId) {
      return l is list && l.size() <= 10
        && (l.size() < 1 || validAttachment(l[0], channelId, messageId))
        && (l.size() < 2 || validAttachment(l[1], channelId, messageId))
        && (l.size() < 3 || validAttachment(l[2], channelId, messageId))
        && (l.size() < 4 || validAttachment(l[3], channelId, messageId))
        && (l.size() < 5 || validAttachment(l[4], channelId, messageId))
        && (l.size() < 6 || validAttachment(l[5], channelId, messageId))
        && (l.size() < 7 || validAttachment(l[6], channelId, messageId))
        && (l.size() < 8 || validAttachment(l[7], channelId, messageId))
        && (l.size() < 9 || validAttachment(l[8], channelId, messageId))
        && (l.size() < 10 || validAttachment(l[9], channelId, messageId));
    }

    // ---------- config ----------
    match /config/{docId} {
      allow read: if isActive();
      allow write: if false; // Cloud Functions only
    }

    // ---------- API tokens: owners see their own (metadata; the doc id is the token's SHA-256) ----------
    match /apiTokens/{tokenId} {
      allow read: if isActive() && resource.data.uid == request.auth.uid;
      allow write: if false; // createapitoken / revokeapitoken callables only
    }

    // ---------- invites: admins read, nobody writes (callable functions only) ----------
    match /invites/{inviteId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isActive();
      allow create, delete: if false; // created by the auth blocking function
      // Users may edit their own profile, never role/status/email.
      allow update: if isActive()
        && request.auth.uid == userId
        && changed().hasOnly(['displayName', 'title', 'photoURL', 'quickReactions', 'customStatus', 'timeZone', 'dnd'])
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 80))
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
            && request.resource.data.photoURL.matches('^https://.*')))
        && (!('title' in request.resource.data) || (request.resource.data.title is string
            && request.resource.data.title.size() <= 120))
        // Three quick-reaction emoji for the message hover bar.
        && (!('quickReactions' in request.resource.data) || (request.resource.data.quickReactions is list
            && request.resource.data.quickReactions.size() == 3
            && request.resource.data.quickReactions[0] is string && request.resource.data.quickReactions[0].size() <= 16
            && request.resource.data.quickReactions[1] is string && request.resource.data.quickReactions[1].size() <= 16
            && request.resource.data.quickReactions[2] is string && request.resource.data.quickReactions[2].size() <= 16))
        // Custom status: { emoji, text, expiresAt (timestamp | null) }, or null to clear.
        && (!('customStatus' in request.resource.data) || request.resource.data.customStatus == null
          || (request.resource.data.customStatus is map
            && request.resource.data.customStatus.keys().hasOnly(['emoji', 'text', 'expiresAt'])
            && request.resource.data.customStatus.emoji is string && request.resource.data.customStatus.emoji.size() <= 16
            && request.resource.data.customStatus.text is string && request.resource.data.customStatus.text.size() <= 100
            && (request.resource.data.customStatus.expiresAt == null || request.resource.data.customStatus.expiresAt is timestamp)))
        // IANA time zone for local time and DND schedules.
        && (!('timeZone' in request.resource.data) || (request.resource.data.timeZone is string && request.resource.data.timeZone.size() <= 64))
        // Do Not Disturb: { until: timestamp | null, schedule: { enabled, start: "HH:MM", end: "HH:MM" } }.
        && (!('dnd' in request.resource.data) || validDnd(request.resource.data.dnd));

      function validDnd(d) {
        return d is map
          && d.keys().hasOnly(['until', 'schedule'])
          && (!('until' in d) || d.until == null || d.until is timestamp)
          && (!('schedule' in d) || (d.schedule is map
            && d.schedule.keys().hasOnly(['enabled', 'start', 'end'])
            && d.schedule.enabled is bool
            && d.schedule.start is string && d.schedule.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && d.schedule.end is string && d.schedule.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
      }

      // Saved-for-later messages: owner only.
      match /saved/{messageId} {
        allow read, delete: if isActive() && request.auth.uid == userId;
        allow create, update: if isActive() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['channelId', 'messageId', 'threadParentId', 'savedAt'])
          && request.resource.data.messageId == messageId
          && request.resource.data.channelId is string
          && (request.resource.data.threadParentId == null || request.resource.data.threadParentId is string)
          && request.resource.data.savedAt == request.time;
      }

      // Scheduled messages and reminders: owner only. The 10-minute sweep (Cloud Function)
      // sends them, so send times must sit on the 10-minute grid, in the future, within a year.
      // Messages can only target a conversation you're in (re-checked when sending).
      match /scheduled/{itemId} {
        allow read, delete: if isActive() && request.auth.uid == userId;
        allow create: if isActive() && request.auth.uid == userId
          && validScheduled(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isActive() && request.auth.uid == userId
          && validScheduled(request.resource.data)
          // Reschedule / edit; retrying a failed item sets it back to pending and clears the error.
          && changed().hasOnly(['sendAt', 'status', 'error', 'text', 'mentions']);
      }

      function validScheduled(d) {
        return d.keys().hasOnly(['kind', 'sendAt', 'status', 'createdAt', 'text', 'channelId', 'threadParentId', 'mentions', 'alsoToChannel', 'messageId'])
          && d.status == 'pending'
          && d.sendAt is timestamp
          && d.sendAt.toMillis() % 600000 == 0
          && d.sendAt > request.time
          && d.sendAt < request.time + duration.value(366, 'd')
          && d.text is string
          && (d.threadParentId == null || d.threadParentId is string)
          && (
            (d.kind == 'message'
              && d.channelId is string
              && isMemberOf(d.channelId)
              && d.text.size() > 0 && d.text.size() <= 40000
              && d.mentions is list && d.mentions.size() <= 50
              && (!('alsoToChannel' in d) || (d.alsoToChannel is bool && d.threadParentId is string))
              && !('messageId' in d))
            || (d.kind == 'reminder'
              && d.text.size() > 0 && d.text.size() <= 500
              && (d.channelId == null || d.channelId is string)
              && (!('messageId' in d) || d.messageId == null || d.messageId is string)
              && !('mentions' in d) && !('alsoToChannel' in d))
          );
      }

      // FCM tokens: owner only; a single doc of { tokens: { <token>: {...} } }.
      match /private/{docId} {
        allow read, delete: if isActive() && request.auth.uid == userId;
        allow create, update: if isActive() && request.auth.uid == userId
          && docId == 'tokens'
          && request.resource.data.keys().hasOnly(['tokens'])
          && request.resource.data.tokens is map
          && request.resource.data.tokens.size() <= 20;
      }

      // Per-channel read markers for unread counts: owner only.
      match /reads/{channelId} {
        allow read: if isActive() && request.auth.uid == userId;
        allow write: if isActive() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['lastReadAt', 'manual'])
          && request.resource.data.lastReadAt is timestamp
          && (!('manual' in request.resource.data) || request.resource.data.manual == true);
      }

      // Per-channel notification setting: owner only. `channelId` is duplicated in the doc so
      // the notifications function can find a channel's subscribers with one indexed query.
      match /channelPrefs/{channelId} {
        allow read: if isActive() && request.auth.uid == userId;
        allow delete: if isActive() && request.auth.uid == userId;
        allow create, update: if isActive() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['level', 'channelId', 'updatedAt'])
          && request.resource.data.level in ['all', 'mentions', 'none']
          && request.resource.data.channelId == channelId
          && request.resource.data.updatedAt == request.time;
      }

      // Activity feed (mentions, thread replies, DMs), written by the notifications function.
      match /activity/{activityId} {
        allow read: if isActive() && request.auth.uid == userId;
        allow delete: if isActive() && request.auth.uid == userId;
        allow create, update: if false;
      }
    }

    // ---------- channels ----------
    match /channels/{channelId} {
      // `resource == null`: reading a DM id that does not exist yet reveals nothing and lets the
      // client check-then-create deterministic DM channels.
      allow read: if isActive()
        && (resource == null || resource.data.type == 'public' || request.auth.uid in resource.data.memberIds);

      // Public / private channels: the creator starts as the only member (private channels may
      // start with more). DMs use a deterministic id "dm_<uid>_<uid>..." listing every member.
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.archived == false
        && request.resource.data.createdAt == request.time
        && uniqueList(request.resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 100
        && safeId(channelId)
        && request.resource.data.keys().hasOnly(['name', 'type', 'memberIds', 'createdBy', 'archived', 'createdAt', 'topic', 'typingKey'])
        && (!('typingKey' in request.resource.data) || validTypingKey(request.resource.data.typingKey))
        && (
          (request.resource.data.type in ['public', 'private']
            && validName(request.resource.data.name)
            && !channelId.matches('^dm_.*')
            && (request.resource.data.type == 'private' || request.resource.data.memberIds == [request.auth.uid]))
          || (request.resource.data.type == 'dm'
            && request.resource.data.name == ''
            && channelId == 'dm_' + request.resource.data.memberIds.join('_')
            && request.resource.data.memberIds.size() >= 1
            && request.resource.data.memberIds.size() <= 9)
        );

      allow update: if isActive() && resource.data.type != 'dm' && (
          // Join a public channel (add only yourself).
          (resource.data.type == 'public' && !resource.data.archived
            && changed().hasOnly(['memberIds'])
            && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1)
          // Leave a channel (remove only yourself).
          || (request.auth.uid in resource.data.memberIds
            && changed().hasOnly(['memberIds'])
            && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()) == [request.auth.uid].toSet()
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1)
          // Members of a private channel may add people.
          || (resource.data.type == 'private' && !resource.data.archived
            && request.auth.uid in resource.data.memberIds
            && changed().hasOnly(['memberIds'])
            && uniqueList(request.resource.data.memberIds)
            && request.resource.data.memberIds.toSet().hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() <= 100)
          // Creator or admin: rename, topic, archive.
          || ((resource.data.createdBy == request.auth.uid || isAdmin())
            && changed().hasOnly(['name', 'topic', 'archived'])
            && validName(request.resource.data.name)
            && request.resource.data.archived is bool
            && (!('topic' in request.resource.data) || (request.resource.data.topic is string && request.resource.data.topic.size() <= 250)))
        )
        || isActive() && lastMessageBump()
        || isActive() && pinsUpdate()
        || isActive() && typingKeySet();

      // Any member sets the channel's typing key once (channels created before it existed).
      function typingKeySet() {
        return request.auth.uid in resource.data.memberIds
          && !('typingKey' in resource.data)
          && changed().hasOnly(['typingKey'])
          && validTypingKey(request.resource.data.typingKey);
      }

      // Any member pins/unpins messages (ids only; max 50).
      function pinsUpdate() {
        return request.auth.uid in resource.data.memberIds
          && !resource.data.archived
          && changed().hasOnly(['pinnedIds'])
          && request.resource.data.pinnedIds is list
          && request.resource.data.pinnedIds.size() <= 50;
      }

      // Any member bumps lastMessageAt/lastMessage in the same batch as posting a message.
      function lastMessageBump() {
        return request.auth.uid in resource.data.memberIds
          && !resource.data.archived
          && changed().hasOnly(['lastMessageAt', 'lastMessage'])
          && request.resource.data.lastMessageAt == request.time
          && request.resource.data.lastMessage.keys().hasOnly(['text', 'authorId'])
          && request.resource.data.lastMessage.authorId == request.auth.uid
          && request.resource.data.lastMessage.text is string
          && request.resource.data.lastMessage.text.size() <= 200;
      }

      allow delete: if false;

      // ---------- messages ----------
      match /messages/{messageId} {
        allow read: if isActive() && isMemberOf(channelId);

        allow create: if isActive()
          && isMemberOf(channelId)
          && !channel(channelId).archived
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['text', 'authorId', 'createdAt', 'threadParentId', 'attachments', 'mentions', 'replyCount', 'lastReplyAt', 'replyUserIds', 'alsoToChannel'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 40000
          && (request.resource.data.threadParentId == null || request.resource.data.threadParentId is string)
          && safeId(messageId)
          && validAttachments(request.resource.data.attachments, channelId, messageId)
          && (request.resource.data.text.size() > 0 || request.resource.data.attachments.size() > 0)
          && request.resource.data.mentions is list
          && request.resource.data.mentions.size() <= 50
          && request.resource.data.replyCount == 0
          && request.resource.data.replyUserIds == []
          // "Also send to #channel" only makes sense on thread replies.
          && (!('alsoToChannel' in request.resource.data)
            || (request.resource.data.alsoToChannel is bool && request.resource.data.threadParentId is string));

        allow update: if isActive() && isMemberOf(channelId) && (
            // Author edits text / removes attachments / soft-deletes.
            (resource.data.authorId == request.auth.uid
              && changed().hasOnly(['text', 'editedAt', 'mentions', 'attachments', 'deleted'])
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 40000
              && request.resource.data.editedAt == request.time
              && validAttachments(request.resource.data.attachments, channelId, messageId)
              && request.resource.data.attachments.size() <= resource.data.attachments.size())
            // The author removes link previews (they're written only by the unfurl function).
            || (resource.data.authorId == request.auth.uid
              && changed().hasOnly(['linkPreviews'])
              && request.resource.data.linkPreviews == [])
            // Any member bumps the thread summary when replying (same batch as the reply).
            || (resource.data.threadParentId == null
              && changed().hasOnly(['replyCount', 'lastReplyAt', 'replyUserIds'])
              && request.resource.data.replyCount == resource.data.replyCount + 1
              && request.resource.data.lastReplyAt == request.time
              && request.resource.data.replyUserIds is list
              && request.resource.data.replyUserIds.size() <= 5
              && request.auth.uid in request.resource.data.replyUserIds)
            // Any member adds/removes their own reactions: reactions = { uid: [emoji, ...] }.
            || (changed().hasOnly(['reactions'])
              && !channel(channelId).archived
              && request.resource.data.reactions is map
              && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
              && (!(request.auth.uid in request.resource.data.reactions)
                || (request.resource.data.reactions[request.auth.uid] is list
                  && request.resource.data.reactions[request.auth.uid].size() <= 20)))
          );

        allow delete: if isActive() && isMemberOf(channelId)
          && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }
  }
}
